# Firebase Environment Variables (for Production/Vercel)
# These MUST be prefixed with VITE_ to be exposed to the client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API Key (handled by the platform, but good to document)
# This is accessed via process.env.GEMINI_API_KEY in vite.config.ts
GEMINI_API_KEY=

