{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Extended user profile data stored in Firestore.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "Unique username for the app." },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "avatar_url": { "type": "string", "description": "URL to the user's avatar image." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role for permissions." },
        "created_at": { "type": "string", "format": "date-time", "description": "Timestamp of account creation." },
        "total_score": { "type": "number", "description": "Total points accumulated in the split." }
      },
      "required": ["username", "email", "role"]
    },
    "AdminConfig": {
      "title": "Global Configuration",
      "description": "Global settings for the application managed by admins.",
      "type": "object",
      "properties": {
        "visibleDays": { "type": "array", "items": { "type": "integer" } },
        "closedDays": { "type": "array", "items": { "type": "integer" } },
        "fantasyRound": { "type": "integer" },
        "fantasyLocked": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/admin_data/{docId}": {
      "schema": "AdminConfig",
      "description": "Global application configuration and data."
    },
    "/notifications/{notifId}": {
      "schema": "object",
      "description": "Global notifications for users."
    }
  }
}
